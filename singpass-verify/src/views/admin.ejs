<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin - Verified Customers - JustRentLah</title>
  <style>
    :root {
      --primary: #1a1a2e;
      --accent: #e94560;
      --bg: #0f0f23;
      --card-bg: #16213e;
      --text: #eaeaea;
      --text-muted: #a0a0b0;
      --border: #2a2a4a;
      --success: #00d97e;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    .header {
      background: var(--primary);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .logo { font-size: 24px; font-weight: 800; }
    .logo span { color: var(--accent); }
    .container { max-width: 960px; margin: 0 auto; padding: 32px 20px; }
    h1 { font-size: 24px; margin-bottom: 8px; }
    .subtitle { color: var(--text-muted); font-size: 14px; margin-bottom: 24px; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th {
      text-align: left;
      padding: 12px 16px;
      background: var(--primary);
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border-bottom: 1px solid var(--border);
    }
    td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
    }
    tr:hover td { background: rgba(233,69,96,0.05); }
    .badge-verified {
      background: rgba(0,217,126,0.15);
      color: var(--success);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-local {
      background: rgba(90,140,255,0.15);
      color: #7aa2ff;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
    }
    .badge-foreign {
      background: rgba(233,69,96,0.15);
      color: var(--accent);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
    }
    .empty {
      text-align: center;
      padding: 48px;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <header class="header">
    <div class="logo">JustRent<span>Lah</span> <span style="font-size:14px;color:var(--text-muted);font-weight:400">Admin</span></div>
  </header>
  <div class="container">
    <h1>Verified Customers</h1>
    <p class="subtitle"><%= verifications.length %> customer<%= verifications.length !== 1 ? 's' : '' %> verified via Singpass</p>

    <% if (verifications.length === 0) { %>
      <div class="empty">No verifications yet. Customers will appear here after verifying with Singpass.</div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>NRIC (last 4)</th>
              <th>Type</th>
              <th>Nationality</th>
              <th>Pass Status</th>
              <th>Email</th>
              <th>Booqable Customer</th>
              <th>Verified At</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% verifications.reverse().forEach(v => { %>
              <tr>
                <td><%= v.name %></td>
                <td>****<%= v.nric_last4 %></td>
                <td>
                  <% if (v.is_foreigner) { %>
                    <span class="badge-foreign">Foreigner</span>
                  <% } else if (v.residential_status) { %>
                    <span class="badge-local"><%= v.residential_status %></span>
                  <% } else { %>-<% } %>
                </td>
                <td><%= v.nationality || '-' %></td>
                <td><%= v.pass_status || '-' %></td>
                <td><%= v.email || '-' %></td>
                <td><%= v.booqableCustomerId || '-' %></td>
                <td><%= new Date(v.verifiedAt).toLocaleString('en-SG', { timeZone: 'Asia/Singapore' }) %></td>
                <td><span class="badge-verified">Verified</span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</body>
</html>
