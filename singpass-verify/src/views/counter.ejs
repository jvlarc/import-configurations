<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Collection Verification - JustRentLah</title>
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
  <style>
    :root {
      --primary: #1a1a2e;
      --accent: #e94560;
      --bg: #0f0f23;
      --card-bg: #16213e;
      --text: #eaeaea;
      --text-muted: #a0a0b0;
      --border: #2a2a4a;
      --success: #00d97e;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .header {
      background: var(--primary);
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
    }
    .logo { font-size: 24px; font-weight: 800; }
    .logo span { color: var(--accent); }
    .tag { font-size: 13px; color: var(--text-muted); }
    .main { flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px 20px; }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 40px;
      max-width: 520px;
      width: 100%;
      text-align: center;
    }
    h1 { font-size: 22px; margin-bottom: 8px; }
    p.sub { color: var(--text-muted); font-size: 14px; margin-bottom: 24px; }
    input, textarea {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 10px;
      color: var(--text);
      padding: 12px 14px;
      font-size: 15px;
      margin-bottom: 14px;
    }
    button {
      width: 100%;
      background: var(--accent);
      color: white;
      border: none;
      border-radius: 10px;
      padding: 14px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }
    button:hover { background: #d63851; }
    #qr { margin: 20px auto; background: white; padding: 16px; border-radius: 12px; width: fit-content; }
    .status-pending { color: var(--text-muted); font-size: 14px; margin-top: 8px; }
    .status-verified {
      background: rgba(0,217,126,0.12);
      border: 1px solid rgba(0,217,126,0.4);
      border-radius: 12px;
      padding: 20px;
      margin-top: 16px;
      color: var(--success);
      font-size: 18px;
      font-weight: 700;
      display: none;
    }
    .pulse {
      display: inline-block;
      width: 10px; height: 10px;
      background: var(--accent);
      border-radius: 50%;
      margin-right: 8px;
      animation: pulse 1.2s infinite;
    }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  </style>
</head>
<body>
  <header class="header">
    <div class="logo">JustRent<span>Lah</span></div>
    <div class="tag">Collection Counter</div>
  </header>
  <main class="main">
    <div class="card">
      <% if (!session) { %>
        <h1>Verify Customer at Collection</h1>
        <p class="sub">Enter the order details, then show the QR to the customer to scan with their Singpass app.</p>
        <form method="POST" action="/counter/start">
          <input name="order_id" placeholder="Booqable Order ID / Number" value="<%= orderId %>">
          <input name="customer_id" placeholder="Booqable Customer ID (optional)">
          <input name="staff_note" placeholder="Note (optional, e.g. items collected)">
          <button type="submit">Generate Verification QR</button>
        </form>
      <% } else { %>
        <h1>Scan with Singpass App</h1>
        <p class="sub">Order: <strong><%= session.orderId || '—' %></strong></p>
        <div id="qr"></div>
        <div class="status-pending" id="pending"><span class="pulse"></span>Waiting for customer to scan and consent…</div>
        <div class="status-verified" id="verified"></div>
        <script>
          QRCode.toCanvas(document.createElement('canvas'), <%- JSON.stringify(qrPayload) %>, { width: 260 }, function (err, canvas) {
            if (!err) document.getElementById('qr').appendChild(canvas);
          });
          const ref = <%- JSON.stringify(session.ref) %>;
          const poll = setInterval(async () => {
            const r = await fetch('/counter/status/' + ref);
            const d = await r.json();
            if (d.status === 'verified') {
              clearInterval(poll);
              document.getElementById('pending').style.display = 'none';
              const v = document.getElementById('verified');
              v.style.display = 'block';
              v.textContent = '✓ Verified: ' + d.name + ' (****' + d.nric_last4 + ')';
            } else if (d.status === 'expired') {
              clearInterval(poll);
              document.getElementById('pending').textContent = 'Session expired — generate a new QR.';
            }
          }, 2500);
        </script>
        <p style="margin-top:24px"><a href="/counter" style="color:var(--accent)">← New verification</a></p>
      <% } %>
    </div>
  </main>
</body>
</html>
