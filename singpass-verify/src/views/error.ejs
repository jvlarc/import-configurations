<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - JustRentLah</title>
  <style>
    :root {
      --primary: #1a1a2e;
      --accent: #e94560;
      --bg: #0f0f23;
      --card-bg: #16213e;
      --text: #eaeaea;
      --text-muted: #a0a0b0;
      --border: #2a2a4a;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .header {
      background: var(--primary);
      padding: 16px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }
    .logo { font-size: 24px; font-weight: 800; }
    .logo span { color: var(--accent); }
    .nav-link { color: var(--text-muted); text-decoration: none; font-size: 14px; }
    .main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 48px 40px;
      max-width: 480px;
      width: 100%;
      text-align: center;
    }
    .error-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 24px;
      background: var(--accent);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .error-icon svg { width: 32px; height: 32px; fill: white; }
    .card h1 { font-size: 24px; margin-bottom: 12px; }
    .card p { color: var(--text-muted); font-size: 15px; line-height: 1.6; margin-bottom: 24px; }
    .btn {
      display: inline-block;
      background: var(--accent);
      color: white;
      border-radius: 12px;
      padding: 14px 28px;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      margin: 0 8px;
      transition: all 0.2s;
    }
    .btn:hover { background: #d63851; }
    .btn-outline {
      background: transparent;
      border: 1px solid var(--border);
    }
    .btn-outline:hover { background: var(--primary); }
    .footer {
      text-align: center;
      padding: 20px;
      color: var(--text-muted);
      font-size: 12px;
      border-top: 1px solid var(--border);
    }
    .footer a { color: var(--accent); text-decoration: none; }
  </style>
</head>
<body>
  <header class="header">
    <div class="logo">JustRent<span>Lah</span></div>
    <a href="https://www.justrentlah.com" class="nav-link">Back to store</a>
  </header>
  <main class="main">
    <div class="card">
      <div class="error-icon">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
      </div>
      <h1><%= title %></h1>
      <p><%= message %></p>
      <a href="/verify" class="btn">Try Again</a>
      <a href="<%= returnUrl %>" class="btn btn-outline">Return to Store</a>
    </div>
  </main>
  <footer class="footer">
    &copy; 2024 JustRentLah. <a href="https://www.justrentlah.com">www.justrentlah.com</a>
  </footer>
</body>
</html>
