# === Singpass Configuration (Myinfo v5 / FAPI 2.0) ===
# App ID from the Singpass Developer Portal -> your app -> Configuration -> Credentials
SINGPASS_CLIENT_ID=your_app_id
SINGPASS_REDIRECT_URI=https://verify.justrentlah.com/auth/callback

# Staging endpoints (shown). For production swap stg-id -> id.
SINGPASS_AUTH_URL=https://stg-id.singpass.gov.sg/auth
SINGPASS_TOKEN_URL=https://stg-id.singpass.gov.sg/token
SINGPASS_JWKS_URL=https://stg-id.singpass.gov.sg/.well-known/keys
# Myinfo v5 person data comes from the OIDC /userinfo endpoint (not the v4 /person API)
SINGPASS_USERINFO_URL=https://stg-id.singpass.gov.sg/userinfo

# Keys — generate with: node scripts/generate-keys.js
# That command prints these four values and writes public keys/jwks.json
# (served at /.well-known/jwks.json). Keep the private values secret.
SIGNING_KID=
ENCRYPTION_KID=
SIGNING_PRIVATE_KEY_B64=
ENCRYPTION_PRIVATE_KEY_B64=

# Myinfo Standard identity scopes only (free tier). Do NOT add Finance scopes.
MYINFO_SCOPES=openid name uinfin dob residentialstatus nationality passportnumber passportexpirydate passtype passstatus mobileno email regadd

# === sgVerify (counter/collection verification) ===
SGVERIFY_CLIENT_ID=your_sgverify_client_id
SGVERIFY_QR_BASE_URL=https://app.singpass.gov.sg/sgverify

# === Booqable Configuration ===
BOOQABLE_COMPANY_SLUG=justrentlah
BOOQABLE_API_KEY=your_booqable_api_key

# === App Configuration ===
APP_URL=https://verify.justrentlah.com
SESSION_SECRET=generate_a_random_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
PORT=3000
